{
  "manifest_version": 3,
  "name": "WatchParty Sync",
  "version": "1.0.0",
  "description": "Watch videos together in perfect sync on any website",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
