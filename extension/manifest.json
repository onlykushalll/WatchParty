{
  "manifest_version": 3,
  "name": "WatchParty Sync for CineVo",
  "version": "1.0.0",
  "description": "Syncs cinevo.nl playback with friends in a WatchParty room. Injects a sync agent that keeps everyone on the same frame.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://cinevo.nl/*",
    "http://localhost:3000/*",
    "http://localhost:3003/*",
    "ws://localhost:3003/*",
    "wss://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://cinevo.nl/*"],
      "js": ["content-cinevo.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://localhost:3000/*", "https://*.space-z.ai/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "https://*.space-z.ai/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WatchParty Sync"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
