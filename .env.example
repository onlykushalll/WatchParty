# WatchParty Environment Variable Configuration

# Application Port (Default: 3000 for web app, 3003 for sync, 3004 for vm)
PORT=3000

# CORS Allowed Origins (Comma-separated or '*' for wildcards)
CORS_ORIGIN=*

# Public Facing Application Base URL
PUBLIC_URL=http://localhost:3000

# Database Connection URL (SQLite or PostgreSQL)
DATABASE_URL="file:./db/watchparty.db"

# Public Microservice URLs (Client-side access)
NEXT_PUBLIC_SYNC_SERVICE_URL=http://localhost:3003
NEXT_PUBLIC_VM_SERVICE_URL=ws://localhost:3004

# Headless Chromium Configuration (VM Service)
CHROME_PATH=/usr/bin/chromium
HEADLESS=true
